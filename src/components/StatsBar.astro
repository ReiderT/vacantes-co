---
import { stats } from '../data/jobs'

const metrics = [
  { label: 'Vacantes técnicas', value: stats.total, hint: 'de 406 registros crudos' },
  { label: 'Últimos 7 días', value: stats.thisWeek, hint: 'publicadas esta semana' },
  { label: 'Perfil firmware', value: stats.firmware, hint: 'embebido, PCB, IoT, automatización' },
  { label: 'Con sueldo', value: stats.withSalary, hint: 'el resto no lo publica' },
]
---

<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4" data-reveal>
  {
    metrics.map((metric) => (
      <div class="rounded-3xl border border-line bg-surface/60 p-6 backdrop-blur-sm">
        <p class="mb-2 font-display text-[10px] tracking-widest text-ink-muted uppercase">{metric.label}</p>
        <p class="font-display text-3xl text-gradient md:text-4xl">{metric.value}</p>
        <p class="mt-2 text-xs font-light text-ink-muted">{metric.hint}</p>
      </div>
    ))
  }
</div>
